#!/bin/sh
# Auto-update the inline "last updated" timestamp at the bottom of the intro
# pages on every commit, so docs.apiany.ai always shows when it was last updated.
# Enable once with: git config core.hooksPath .githooks  (pnpm install does this).

node scripts/update-docs-version.mjs || exit 1
git add introduction.mdx fr/introduction.mdx de/introduction.mdx zh/introduction.mdx \
  ja/introduction.mdx ko/introduction.mdx es/introduction.mdx
