  "theme": "mint",
  "colors": {
    "primary": "#174CFF",
    "light": "#174CFF",
    "dark": "#8AB4FF"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon.svg"
  },
  "logo": {
