          "tools": {
            "type": "array",
            "description": "Declaraciones de herramientas con functionDeclarations.",
            "items": { "type": "object", "additionalProperties": true }
          },
          "systemInstruction": {
            "type": "object",
            "additionalProperties": true,
            "description": "Instrucción del sistema, como objeto Content de Gemini ({ parts: [{ text }] })."
