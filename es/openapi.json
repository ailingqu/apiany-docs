      "AnthropicMessagesRequest": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "example": "minimax-m3"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  ]
                }
              },
              "required": [
                "role",
                "content"
              ]
            }
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Número máximo de tokens a generar (obligatorio)."
          },
          "system": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "object", "additionalProperties": true } }
            ],
            "description": "Prompt del sistema."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Aleatoriedad (0–1)."
          },
          "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
          "top_k": { "type": "integer", "description": "Muestrea solo entre los K candidatos de mayor probabilidad." },
          "stop_sequences": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Secuencias de parada personalizadas."
          },
          "tools": {
            "type": "array",
            "description": "Herramientas que el modelo puede invocar; cada una incluye name, description e input_schema (JSON Schema).",
            "items": { "type": "object", "additionalProperties": true }
          },
          "tool_choice": {
            "type": "object",
            "additionalProperties": true,
            "description": "Selección de herramienta: { type: 'auto' } | { type: 'any' } | { type: 'tool', name }."
          },
          "stream": {
            "type": "boolean",
            "description": "Cuando es true, se devuelve un flujo de eventos SSE de Anthropic (message_start / content_block_delta / message_delta / message_stop)."
          }
        },
        "required": [
          "model",
          "messages",
          "max_tokens"
        ]
      },
